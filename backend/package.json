{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "description": "Express API for the AI-Assisted Child Development Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "test": "jest"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "fsevents": false
  }
}
