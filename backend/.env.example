# Copy this file to .env and fill in real values. Never commit .env.
PORT=3001
# SQLite file; defaults to backend/data/app.sqlite when empty
DB_FILE=
# Secret used to sign login tokens (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When empty, the server uses a temporary secret and logins end on every restart.
JWT_SECRET=
